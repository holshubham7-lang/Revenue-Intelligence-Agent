# ---------------------------------------------------------------------------
# API service configuration — copy to .env and fill in.
#
# `APP_BASE_URL` and `AUTH_SECRET` are required; the service refuses to boot
# without them. See src/common/config.ts for the validation and the reasoning.
# ---------------------------------------------------------------------------

# The origin the BROWSER uses. Required.
#
# The browser only ever talks to the Next.js frontend on :3000; this service sits
# behind its `/api/*` rewrite on :3010. A request arriving here therefore carries
# this service's own Host header, so it cannot infer the browser's origin — and
# an origin built from that would produce OAuth callbacks of
# http://localhost:3010/api/auth/oauth/<provider>/callback, which no provider has
# registered. Every social sign-in redirect uses this value.
#
# Must be a bare origin: no trailing path.
APP_BASE_URL=http://localhost:3000

# Signs session cookies and the OAuth transaction state.
#
# At least 32 characters. Rotating it invalidates every session and every
# in-flight social sign-in.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Port this service listens on. Default 3010. The frontend proxies to this.
PORT=3010

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

MONGODB_URI=mongodb://localhost:27017
# The v1.1 data lives in `revops`; changing this points the service at a
# different database without touching the URI.
MONGODB_DB=revops

# ---------------------------------------------------------------------------
# Social sign-in
#
# The client ids and secrets are reusable from the v1.0 app registrations, but
# the REDIRECT URIs must be re-registered to the frontend origin, because the
# callback is served by Next.js and rewritten to this service — the browser never
# reaches port 3010 itself.
#
# Each is optional: a provider with no credentials returns a `not_configured`
# error that the sign-in page renders, rather than failing at boot. That keeps a
# partially configured deployment startable.
#
#   http://localhost:3000/api/auth/oauth/<provider>/callback
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` allows both work/personal Microsoft accounts. Set a tenant id to
# restrict the app to a single organisation.
MICROSOFT_TENANT=common

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# CORS
#
# Leave empty for the intended setup: the browser never calls this service
# cross-origin, because Next.js proxies `/api/*` on its own origin. Set a
# comma-separated list only if a separate trusted client needs to call the API
# directly. Credentials are never allowed across origins.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Foundry agent (Responses protocol)
#
# The deployed agent that writes the onboarding questions from the uploaded
# reports. Both have working defaults; set them only if the agent is renamed or
# the service moves to a new preview version.
#
# This route requires an api-version query parameter (the project-level
# /openai/v1 route rejects one), and 2025-05-15-preview is the version the agent
# service currently accepts.
# ---------------------------------------------------------------------------

AZURE_FOUNDRY_AGENT_NAME=Rev-Ops-V1
AZURE_FOUNDRY_AGENT_API_VERSION=2025-05-15-preview
