# Environment and secrets
.env
.env.*
!.env.example
# Legacy Google OAuth client JSON (should no longer be used; secrets moved to Key Vault)
apps.googleusercontent.com.json

# Local-only root files (docs / notes are kept out of the repo)
/0
/revops app details.txt
/RevOps-Agent-V1.0-Technical-Documentation.docx
/*.doc
/*.docx
/*.txt
/*.pdf
/*.md
/*.log

# Node
node_modules/

# Logs
*.log

# Build output
frontend/.next/
api/dist/
*.tsbuildinfo
admin/api/dist/
# v1.1 lives side-by-side under its own paths, so the same build output
# patterns are repeated for it (the ones above are root-anchored).
v1.1/frontend/.next/
v1.1/api/dist/

# Local runtime state for the v1.1 API: uploaded workbooks and cached exports
v1.1/**/.data/

# Local deploy artifacts (Azure App Service packages)
*-deploy.zip

# OS / editor
.DS_Store
Thumbs.db
