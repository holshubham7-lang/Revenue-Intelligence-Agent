# Environment and secrets
.env
.env.*
!.env.example
# Legacy Google OAuth client JSON (should no longer be used; secrets moved to Key Vault)
apps.googleusercontent.com.json

# Local-only root files (docs / notes are kept out of the repo)
/0
/revops app details.txt
/RevOps-Agent-V1.0-Technical-Documentation.docx
/*.doc
/*.docx
/*.txt
/*.pdf
/*.md
/*.log

# Node
node_modules/

# Logs
*.log

# Build output
frontend/.next/
api/dist/
*.tsbuildinfo
admin/api/dist/

# Local runtime state: uploaded workbooks and cached exports
.data/

# OS / editor
.DS_Store
Thumbs.db

# Excel's lock file, present only while a .xlsx is open. It is a temp artefact of
# the file being open, not part of the data set.
~$*.xlsx

# One-off database inspection/migration scripts written while debugging. They
# read MONGODB_URI from the environment and are not part of the service.
api/_*.mjs

# Sample workbooks used to try a scenario out locally. They are real business
# exports, not fixtures, so they stay out of the repository and out of history.
use-case/
