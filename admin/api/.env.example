PORT=3020
MONGODB_URI=mongodb://localhost:27017/revops
# Comma-separated emails allowed to sign in to the Master Admin Panel.
# Users must first exist (via the main app) and belong to this list.
ADMIN_EMAILS=you@example.com
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=change-me
ADMIN_SESSION_TTL=604800
# Shared field-encryption key (base64, 32 bytes) used to decrypt user names.
# Must match the main api/.env ENCRYPTION_KEY (or vault equivalent).
ENCRYPTION_KEY=change-me-32-byte-base64
# Origin of the admin frontend (CORS + credentials).
CORS_ORIGIN=http://localhost:3001
COOKIE_SECURE=false