# Social sign-in (Google, Microsoft, LinkedIn)
#
# Copy to `.env.local` and fill in. Every provider is independent: leaving one
# blank disables that button's flow and nothing else. A provider with no
# credentials redirects back to /signin with "isn't configured on this
# deployment" rather than failing at the provider.
#
# The four console settings that cause "works for me, not for them" are listed
# beside each provider. They are the settings, not the code.

# Origin used to build OAuth callback URLs. Set this in production, where the
# app sits behind a proxy whose headers may or may not be forwarded. No trailing
# slash. Leave unset in local dev and the request origin is used instead.
# APP_BASE_URL=http://localhost:3000

# Signs the session cookie and the OAuth state cookie. Must be at least 32
# characters. Generate with: openssl rand -base64 48
# AUTH_SECRET=

# --- Google -----------------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
#  - Create an OAuth client ID, type "Web application".
#  - Authorized redirect URI: {APP_BASE_URL}/api/auth/oauth/google/callback
#  - OAuth consent screen: publishing status must be "In production".
#     In "Testing" only listed test users can sign in, and everyone else gets
#     "Access blocked: this app is currently being tested". This is the single
#     most common cause of sign-in working for the developer only.
#  - Authorized JavaScript origins: {APP_BASE_URL}
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Microsoft / Entra ID ---------------------------------------------------
# Console: https://portal.azure.com -> Microsoft Entra ID -> App registrations
#  - Supported account types: "Accounts in any organizational directory", plus
#     "Personal Microsoft accounts" for @outlook.com / @hotmail.com users.
#     Left on "My organization", nobody outside the registering tenant can sign
#     in.
#  - Redirect URI (Web): {APP_BASE_URL}/api/auth/oauth/microsoft/callback
#  - No admin consent needed: only the OIDC scopes `openid email profile` are
#     requested. Do not add Microsoft Graph permissions such as User.Read — in a
#     tenant with admin-consent required, they block sign-in for exactly the
#     users outside your organisation.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Restrict to a single tenant (e.g. contoso.onmicrosoft.com). Leave unset to
# allow any organisational and personal account, which is the default.
# MICROSOFT_TENANT=

# --- LinkedIn ---------------------------------------------------------------
# Console: https://www.linkedin.com/developers/apps
#  - Products -> "Sign In with LinkedIn using OpenID Connect". This is a manual
#     approval and cannot be self-serve; without it the authorize call returns
#     403 for every user.
#  - Redirect URL: {APP_BASE_URL}/api/auth/oauth/linkedin/callback
#  - App must be in "Live" status, not "Development".
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# How /api is served
#
# `next dev` and `next start` both read this file at boot, so changing it means
# restarting the server.
# ---------------------------------------------------------------------------

# The NestJS service, reachable only from this process. The browser keeps calling
# same-origin /api, which is what keeps the session and CSRF cookies first-party.
# API_INTERNAL_URL=http://localhost:3010

# Set to "true" to route /api/* to NestJS. Off means the app/api/** handlers
# answer them in this process instead. Whatever it is, the onboarding routes stay
# on the rewrite: they need the agent client, which lives in the API.
# API_REWRITE_ENABLED=false

# ---------------------------------------------------------------------------
# Server-side settings
#
# Route handlers and server components read MongoDB, Foundry and Blob storage
# from this process, so the names in `api/.env.example` apply here too — same
# value, same process environment. Keep the two in sync; a mismatch means the
# rewrite and the handlers disagree about which database they are on.
#
#   MONGODB_URI  MONGODB_DB  AUTH_SECRET  DATA_ENCRYPTION_KEY
#   AZURE_OPENAI_ENDPOINT  AZURE_OPENAI_KEY  AZURE_OPENAI_DEPLOYMENT_NAME
#   AZURE_STORAGE_ACCOUNT  AZURE_STORAGE_KEY  AZURE_STORAGE_CONTAINER
#   AZURE_STORAGE_SAS_TOKEN
#
# Nothing here may be a NEXT_PUBLIC_* value: the client bundle is public, and
# every name above is a credential.
# ---------------------------------------------------------------------------
