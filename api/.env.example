# Copy to .env and fill in values. NEVER commit .env.
# Boot is fail-closed: secrets must come from Azure Key Vault (KEY_VAULT_URL).
# Local-only escape hatch: set ALLOW_LOCAL_SECRETS=true to read from this file.

# --- Azure Key Vault ---
# Required unless ALLOW_LOCAL_SECRETS=true.
# KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Field encryption strategy:
#   kek          = standard Key Vault DEK/KEK (RSA KEK never leaves vault,
#                  AES-256 DEK stored wrapped as ENCRYPTION-KEY-WRAPPED).
#   managed-hsm  = Azure Managed HSM oct-HSM AES-256 key; all AES-256-GCM
#                  encrypt/decrypt runs inside the HSM, key never exportable.
# KEY_VAULT_MODE=kek
# Local dev only — remove for real protection.
ALLOW_LOCAL_SECRETS=false

# --- Server ---
PORT=3010
MONGODB_URI=mongodb://localhost:27017/revops
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Auth / session ---
# JWT_SECRET and ENCRYPTION_KEY come from Key Vault in production (JWT-SECRET,
# ENCRYPTION-KEY). The ENCRYPTION-KEY secret is adopted as the AES-256 DEK and
# then wrap-custodied by the vault key "encryption-kek". Generate a local value
# (dev only) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=604800
SESSION_COOKIE_NAME=stratveda_session
COOKIE_SECURE=false

# --- Social login ---
# Google / Microsoft / LinkedIn client id+secret are loaded from Key Vault in
# production (GOOGLE-CLIENT-ID, GOOGLE-CLIENT-SECRET, MICROSOFT-CLIENT-ID,
# MICROSOFT-CLIENT-SECRET, LINKEDIN-CLIENT-ID, LINKEDIN-CLIENT-SECRET).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Microsoft tenant (default 'common'); e.g. 'organizations' or a tenant GUID.
MICROSOFT_TENANT=

CALLBACK_BASE=http://localhost:3010
FRONTEND_URL=http://localhost:3000